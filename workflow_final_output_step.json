          "keepOnlySet": true
        }
      },
      "name": "Préparer la Sortie Fichier",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        2650,
        300
      ],
      "id": "e5f6a7b8-c9d0-e1f2-a3b4-c5d6e7f8a9b0"
    }
  ],
