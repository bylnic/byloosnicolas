            }
          ]
        },
        "options": {
          "keepOnlySet": false
        }
      },
      "name": "Construire l'URL de recherche",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "id": "c2d3e4f5-a6b7-8901-2345-abcdef123456"
    },
    {
      "parameters": {
        "url": "={{$json.fullSearchUrl}}",
        "method": "GET",
        "options": {
          "response": {
            "neverError": true,
            "responseType": "string"
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/98.0.4758.102 Safari/537.36"
            }
          ]
        }
      },
      "name": "Accéder à la page de recherche",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "id": "d3e4f5a6-b7c8-9012-3456-bcdefa234567"
    },
    {
      "parameters": {
        "sourceValue": "={{$node[\"Accéder à la page de recherche\"].json.data}}",
        "extractionValues": [
          {
            "key": "price",
            "cssSelector": "={{$json.priceSelector}}",
            "returnValue": "text"
          },
          {
            "key": "delivery",
            "cssSelector": "={{$json.deliverySelector}}",
            "returnValue": "text"
          },
          {
            "key": "productLink",
            "cssSelector": "={{$json.productLinkSelector}}",
            "returnValue": "attribute",
            "attribute": "href"
          }
        ],
        "options": {
          "includeHtml": false,
          "keepSource": false,
          "trim": true,
          "continueOnFail": true
        }
      },
      "name": "Extraire les données du produit",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ],
      "id": "e4f5a6b7-c8d9-0123-4567-cdefab345678"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "siteName",
              "value": "={{$json.name}}"
            },
            {
              "name": "price",
              "value": "={{$node['Extraire les données du produit'].json.price ? $node['Extraire les données du produit'].json.price.text.trim() : \"Non précisé\"}}"
            },
            {
              "name": "deliveryInfo",
              "value": "={{$node['Extraire les données du produit'].json.delivery ? $node['Extraire les données du produit'].json.delivery.text.trim() : \"Non précisé\"}}"
            },
            {
              "name": "extractedProductLink",
              "value": "={{$node['Extraire les données du produit'].json.productLink ? $node['Extraire les données du produit'].json.productLink.href : \"Non trouvé\"}}"
            },
            {
              "name": "warrantyInfo",
              "value": "Non précisé"
            },
            {
              "name": "timestamp",
              "value": "={{new Date().toISOString()}}"
            },
            {
              "name": "searchPageUrl",
              "value": "={{$node['Accéder à la page de recherche'].json.request.url}}"
            }
          ]
        },
        "options": {
          "keepOnlySet": false
        }
      },
      "name": "Nettoyer et Structurer les Données Produit",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1650,
        300
      ],
      "id": "f5a6b7c8-d9e0-1234-5678-defabc456789"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "simulatedScreenshotDescription",
              "value": "Capture simulée pour {{$json.siteName}}: Prix affiché: {{$json.price}}. Informations de livraison: {{$json.deliveryInfo}}. Lien produit identifié: {{$json.extractedProductLink}}. URL de recherche utilisée: {{$json.searchPageUrl}}."
            }
          ]
        },
        "options": {
          "keepOnlySet": false
        }
      },
      "name": "Générer Description Textuelle (Capture Simulée)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1850,
        300
      ],
      "id": "a0b1c2d3-e4f5-a6b7-c8d9-e0f1a2b3c4d5"
    },
    {
      "parameters": {},
      "name": "Fin du traitement pour ce site",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2050,
        300
      ],
      "id": "b1c2d3e4-f5a6-b7c8-d9e0-f1a2b3c4d5e6"
    },
    {
      "parameters": {
        "functionCode": "// items contient tous les produits analysés, un par site\nconst products = items.map(item => item.json);\n\nlet bestOffer = null;\nlet minPrice = Infinity;\n\n// Filtrer les produits qui ont un prix valide (pas \"Non précisé\" et convertible en nombre)\nconst validProducts = products.filter(p => {\n  if (p.price && typeof p.price === 'string') {\n    const numericPrice = parseFloat(p.price.replace(/[^0-9,.-]/g, '').replace(',', '.'));\n    return !isNaN(numericPrice);\n  }\n  return false;\n});\n\nif (validProducts.length === 0) {\n  items.push({\n    json: {\n      recommendationText: \"Aucune recommandation possible : aucun prix valide n'a été trouvé.\",\n      isRecommendation: true\n    }\n  });\n  return items;\n}\n\nfor (const product of validProducts) {\n  const priceStr = product.price.replace(/[^0-9,.-]/g, '').replace(',', '.');\n  const priceNum = parseFloat(priceStr);\n\n  if (priceNum < minPrice) {\n    minPrice = priceNum;\n    bestOffer = product;\n  }\n}\n\nlet recommendationText = \"Recommandation : \";\nif (bestOffer) {\n  recommendationText += `L'offre la plus avantageuse semble être sur ${bestOffer.siteName} à ${bestOffer.price}.`;\n  // On pourrait ajouter ici une comparaison des frais de livraison si disponibles et pertinents.\n} else {\n  // Ce cas ne devrait pas être atteint si validProducts.length > 0\n  recommendationText += \"Aucun produit avec un prix valide trouvé pour faire une recommandation.\";\n}\n\nconst recommendationItem = {\n  json: {\n    siteName: \"RECOMMANDATION GLOBALE\", // Pour identifier cette ligne dans le tableau\n    price: recommendationText,\n    deliveryInfo: \"\",\n    warrantyInfo: \"\",\n    extractedProductLink: \"\",\n    simulatedScreenshotDescription: \"\",\n    isRecommendationFlag: true // Pour potentiellement la traiter différemment\n  }\n};\n\n// Retourne les items originaux et le nouvel item de recommandation\nreturn [...items, recommendationItem];"
      },
      "name": "Analyser et Recommander l'Offre",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2250,
        300
      ],
      "id": "d3e4f5a6-b7c8-d9e0-f1a2-b3c4d5e6f7a8"
    },
    {
      "parameters": {
        "operation": "writeFile",
        "fileFormat": "xlsx",
        "fileName": "Comparatif_Produits_Velo_Electrique",
        "binaryPropertyName": "data",
        "columns": [
          { "header": "Site", "value": "={{$json.siteName}}" },
          { "header": "Prix TTC", "value": "={{$json.price}}" },
          { "header": "Livraison", "value": "={{$json.deliveryInfo}}" },
          { "header": "Garantie", "value": "={{$json.warrantyInfo}}" },
          { "header": "Lien", "value": "={{$json.extractedProductLink}}" },
          { "header": "Description (Simulée)", "value": "={{$json.simulatedScreenshotDescription}}" }
        ],
        "options": {}
      },
      "name": "Générer Tableau Comparatif Excel",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [
        2450,
        300
      ],
      "id": "c2d3e4f5-a6b7-c8d9-e0f1-a2b3c4d5e6f7"
    },
